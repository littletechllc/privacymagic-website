<section class="cta-section" id="install">
  <h2>{{ cta.titleBefore }} <span class="highlight">{{ cta.titleHighlight }}</span>{{ cta.titleAfter }}</h2>
  <p>{{ cta.description }}</p>
  <a href="{{ site.chromeStoreUrl }}" class="hero-cta">
    <span class="hero-cta-icon" aria-hidden="true">{{ "hamsa-white.svg" | inlineSvg | safe }}</span>
    {{ cta.button }}
  </a>
  <p class="cta-follow">
    Follow us:
    <span class="cta-follow-links">
      {% set iconClass = "cta-follow-icon" %}
      {% include "partials/social-icons.njk" %}
    </span>
  </p>
</section>
