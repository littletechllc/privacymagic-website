<nav>
  <a href="/" class="logo">
    <span class="logo-icon">
      {{ "logo.svg" | inlineSvg | safe }}
    </span>
    Privacy Magic
  </a>
  <div class="nav-actions">
    <div class="nav-social">
      <a href="{{ site.xUrl }}" rel="noopener noreferrer" aria-label="Follow us on X"><span class="nav-social-icon">{{ "x.svg" | inlineSvg | safe }}</span></a>
      <a href="{{ site.githubUrl }}" rel="noopener noreferrer" aria-label="View source on GitHub"><span class="nav-social-icon">{{ "github.svg" | inlineSvg | safe }}</span></a>
    </div>
    <a href="{{ site.chromeStoreUrl }}" class="cta-nav">Add to Chrome</a>
    <details class="nav-menu">
      <summary class="nav-menu-toggle" aria-label="Open menu">
        <span class="nav-menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>
      <ul class="nav-menu-panel">
        {% for item in nav %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {% endfor %}
        <li class="nav-menu-social">
          <div class="nav-menu-social-links">
            {% set iconClass = "nav-menu-social-icon" %}
            {% include "partials/social-icons.njk" %}
          </div>
        </li>
      </ul>
    </details>
  </div>
</nav>
<script>
  const menu = document.querySelector(".nav-menu");
  if (menu) {
    menu.querySelector(".nav-menu-panel")?.addEventListener("click", (event) => {
      if (event.target.closest("a")) menu.open = false;
    });

    document.addEventListener("click", (event) => {
      if (!menu.open || menu.contains(event.target)) return;
      menu.open = false;
    });
  }
</script>
