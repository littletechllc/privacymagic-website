<!DOCTYPE html>
<html lang="{{ locale | localeLang }}" dir="{{ locale | localeDir }}">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title>{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}</title>
  <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
  {% if locale and translationPage %}
  {% if translationPage == "protections" %}
    {% set hreflangTranslations = protectionsTranslations %}
  {% elif translationPage == "about" %}
    {% set hreflangTranslations = aboutTranslations %}
  {% elif translationPage == "privacy-policy" %}
    {% set hreflangTranslations = privacyPolicyTranslations %}
  {% endif %}
  <link rel="alternate" hreflang="en" href="{{ site.url }}/{{ translationPage }}/" />
  {% for translation in hreflangTranslations %}
  <link rel="alternate" hreflang="{{ translation.locale | localeLang }}" href="{{ site.url }}/{{ translation.locale }}/{{ translationPage }}/" />
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/{{ translationPage }}/" />
  {% endif %}
  <link rel="me" href="{{ site.mastodonUrl }}" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
  <link rel="icon" type="image/png" href="/favicon-192x192.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="stylesheet" href="/fonts/fonts.css">
  <link rel="stylesheet" href="/css/site.css">
</head>

<body>
  {% include "partials/nav.njk" %}
  {{ content | safe }}
  {% include "partials/footer.njk" %}
</body>

</html>
