---
layout: layouts/base.njk
---
{% if author %}
  {% if author.name %}
    {% set authorData = author %}
  {% else %}
    {% set authorData = authors[author] %}
  {% endif %}
{% endif %}
<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    {% if description %}
    <p class="post-lead">{{ description }}</p>
    {% endif %}
    {% if authorData and authorData.name %}
    <p class="post-byline">by <a href="#author">{{ authorData.name }}</a></p>
    {% endif %}
    {% if showDate and date %}
    <p class="post-date"><time datetime="{{ date | isoDate }}">{{ date | longDate }}</time></p>
    {% endif %}
  </header>
  <div class="post-content">
    {{ content | safe }}
  </div>
  {% if authorData %}
  <aside class="author-bio" id="author">
    <div class="author-bio-photo">
      {% if authorData.photo %}
      <img src="{{ authorData.photo }}" alt="{{ authorData.name }}">
      {% endif %}
    </div>
    <div class="author-bio-text">
      {% if authorData.name %}
      <p class="author-bio-name">{{ authorData.name }}</p>
      {% endif %}
      {% if authorData.title %}
      <p class="author-bio-title">{{ authorData.title }}</p>
      {% endif %}
      {% if authorData.bio %}
      <div class="author-bio-body">{{ authorData.bio | safe }}</div>
      {% endif %}
    </div>
  </aside>
  {% endif %}
  <p class="post-back-to-top"><button type="button" class="post-back-to-top-link">↑ Back to top</button></p>
</article>
<script>
  const scrollToPageTop = () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
    history.replaceState(null, "", window.location.pathname + window.location.search);
  };

  const backToTop = document.querySelector(".post-back-to-top");
  const titleHeading = document.querySelector(".post-header h1");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let backToTopFrame = 0;

  const updateBackToTop = () => {
    if (backToTop == null || titleHeading == null) return;
    const navHeight = document.querySelector("nav")?.getBoundingClientRect().height ?? 0;
    const pastTitle = navHeight - titleHeading.getBoundingClientRect().bottom;
    const travel = backToTop.offsetHeight + (parseFloat(getComputedStyle(backToTop).bottom) || 0);
    let shift = Math.min(travel, Math.max(0, travel - pastTitle));
    if (prefersReducedMotion.matches) {
      shift = pastTitle > 0 ? 0 : travel;
    }
    backToTop.style.setProperty("--back-to-top-shift", `${shift}px`);
    const hidden = shift >= travel - 0.5;
    backToTop.classList.toggle("is-visible", !hidden);
    backToTop.toggleAttribute("inert", hidden);
    backToTop.setAttribute("aria-hidden", hidden ? "true" : "false");

    const article = document.querySelector(".post");
    const button = backToTop.querySelector(".post-back-to-top-link") ?? backToTop;
    let inGutter = true;
    if (article != null) {
      const articleRect = article.getBoundingClientRect();
      const articlePaddingRight = parseFloat(getComputedStyle(article).paddingRight) || 0;
      inGutter =
        button.getBoundingClientRect().left >=
        articleRect.right - articlePaddingRight + 8;
    }
    backToTop.classList.toggle("is-in-gutter", inGutter);
  };

  const scheduleBackToTop = () => {
    if (backToTopFrame) return;
    backToTopFrame = requestAnimationFrame(() => {
      backToTopFrame = 0;
      updateBackToTop();
    });
  };

  backToTop?.querySelector(".post-back-to-top-link")?.addEventListener("click", scrollToPageTop);
  window.addEventListener("scroll", scheduleBackToTop, { passive: true });
  window.addEventListener("resize", scheduleBackToTop);
  updateBackToTop();

  document.querySelector(".post-header h1 a.heading-anchor")?.addEventListener("click", (event) => {
    event.preventDefault();
    scrollToPageTop();
  });

  if (titleHeading?.id && window.location.hash === `#${titleHeading.id}`) {
    scrollToPageTop();
  }

  (function () {
    const tables = document.querySelectorAll(".post-content table");
    if (tables.length === 0) return;

    const syncTableHeaderHeights = () => {
      tables.forEach((table) => {
        const thead = table.querySelector("thead");
        if (thead == null) return;
        table.style.setProperty(
          "--sticky-table-header-height",
          `${Math.ceil(thead.getBoundingClientRect().height)}px`
        );
      });
    };

    const scrollTableToTop = (table) => {
      table.scrollIntoView({ block: "start" });
    };

    const retargetHash = () => {
      const id = window.location.hash.slice(1);
      if (!id) return;
      const target = document.getElementById(id);
      if (target == null) return;
      const table = target.closest(".post-content table");
      if (table == null) return;
      if (target.closest("thead")) {
        scrollTableToTop(table);
        return;
      }
      target.scrollIntoView();
    };

    document.querySelectorAll(".post-content thead th a.heading-anchor").forEach((link) => {
      link.addEventListener("click", (event) => {
        const table = link.closest("table");
        if (table == null) return;
        event.preventDefault();
        const href = link.getAttribute("href");
        if (href && window.location.hash !== href) {
          history.pushState(null, "", href);
        }
        scrollTableToTop(table);
      });
    });

    document.querySelectorAll(
      ".post-content :is(th, td):nth-child(1) a.heading-anchor"
    ).forEach((link) => {
      link.addEventListener("click", () => {
        link.blur();
        requestAnimationFrame(() => link.blur());
      });
    });

    window.addEventListener("hashchange", retargetHash);
    window.addEventListener("popstate", retargetHash);

    syncTableHeaderHeights();
    if (window.location.hash) {
      requestAnimationFrame(() => {
        syncTableHeaderHeights();
        retargetHash();
      });
    }

    if (typeof ResizeObserver === "undefined") {
      window.addEventListener("resize", syncTableHeaderHeights);
      return;
    }

    const observer = new ResizeObserver(syncTableHeaderHeights);
    tables.forEach((table) => {
      const thead = table.querySelector("thead");
      if (thead != null) observer.observe(thead);
    });
  })();
</script>
